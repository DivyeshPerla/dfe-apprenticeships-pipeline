s-2026", "job_id": "c796107f-7b1f-40b3-8b5a-730271e95f7d"}, "message": null, "failures": 0, "unique_id": "test.dfe_apprenticeships.assert_current_matches_latest_version", "compiled": true, "compiled_code": "-- The set of is_current records must be exactly the newest published version.\n-- If SCD-2 validity intervals are wrong, this drifts immediately.\n-- Returns rows on failure.\n\nwith current_count as (\n    select count(*) as n\n    from `dfe-apprenticeships-2026`.`gold`.`fct_apprenticeship_headline`\n    where is_current\n),\nexpected as (\n    select total_results as n\n    from `dfe-apprenticeships-2026`.`silver`.`dataset_versions`\n    qualify row_number() over (order by version_seq desc) = 1\n)\nselect\n    c.n as current_records,\n    e.n as expected_records\nfrom current_count c\ncross join expected e\nwhere c.n != e.n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-24T08:37:14.688159Z", "completed_at": "2026-08-24T08:37:14.705865Z"}, {"name": "execute", "started_at": "2026-08-24T08:37:14.706202Z", "completed_at": "2026-08-24T08:37:15.927206Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 1.2458410263061523, "adapter_response": {"_message": "SELECT (1.0 rows, 0 processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 0, "bytes_billed": 0, "location": "europe-west2", "project_id": "dfe-apprenticeships-2026", "job_id": "a23866ab-4309-48e7-83cc-4bdc84442f10"}, "message": null, "failures": 0, "unique_id": "test.dfe_apprenticeships.dbt_utils_unique_combination_of_columns_fct_apprenticeship_headline_row_key__valid_from_seq.15161f8a56", "compiled": true, "compiled_code": "\n\n\n\n\n\nwith validation_errors as (\n\n    select\n        row_key, valid_from_seq\n    from `dfe-apprenticeships-2026`.`gold`.`fct_apprenticeship_headline`\n    group by row_key, valid_from_seq\n    having count(*) > 1\n\n)\n\nselect *\nfrom validation_errors\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-24T08:37:14.630496Z", "completed_at": "2026-08-24T08:37:14.639970Z"}, {"name": "execute", "started_at": "2026-08-24T08:37:14.640322Z", "completed_at": "2026-08-24T08:37:15.927984Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 1.3061580657958984, "adapter_response": {"_message": "SELECT (1.0 rows, 0 processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 0, "bytes_billed": 0, "location": "europe-west2", "project_id": "dfe-apprenticeships-2026", "job_id": "5817e22f-11fc-4d38-a187-9962b69c07ae"}, "message": null, "failures": 0, "unique_id": "test.dfe_apprenticeships.dbt_utils_accepted_range_stg_apprenticeships_academic_year_start__2030__2017.b6d810965b", "compiled": true, "compiled_code": "\n\nwith meet_condition as(\n  select *\n  from `dfe-apprenticeships-2026`.`silver`.`stg_apprenticeships`\n),\n\nvalidation_errors as (\n  select *\n  from meet_condition\n  where\n    -- never true, defaults to an empty result set. Exists to ensure any combo of the `or` clauses below succeeds\n    1 = 2\n    -- records with a value >= min_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not academic_year_start >= 2017\n    -- records with a value <= max_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not academic_year_start <= 2030\n)\n\nselect *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-24T08:37:14.613028Z", "completed_at": "2026-08-24T08:37:14.616378Z"}, {"name": "execute", "started_at": "2026-08-24T08:37:14.616839Z", "completed_at": "2026-08-24T08:37:16.730396Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 2.1217730045318604, "adapter_response": {"_message": "SELECT (1.0 rows, 2.3 MiB processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 2422628, "bytes_billed": 10485760, "location": "europe-west2", "project_id": "dfe-apprenticeships-2026", "job_id": "bd106042-55b5-47b8-b2e3-e1b8359c0c92", "slot_ms": 237}, "message": null, "failures": 0, "unique_id": "test.dfe_apprenticeships.assert_detail_grain_reconciles_to_published_total", "compiled": true, "compiled_code": "-- Summing detail-grain rows must reproduce the publisher's grand total to\n-- within rounding tolerance.\n--\n-- WHY NOT EXACT: every published figure is rounded to the nearest 10 as part\n-- of DfE's statistical disclosure control (verified: 42,045/42,045 published\n-- start_count values are multiples of 10, minimum 10). Summing ~122\n-- independently-rounded detail values cannot equal an independently-rounded\n-- grand total. Expected error is roughly 5*sqrt(n) ~ 55 for n=122; observed\n-- differences across the nine years are 0-90.\n--\n-- The tolerance is set at 0.1% of the published total (~350 on a 350,000\n-- base) -- comfortably above rounding noise, but far below the ~24x error a\n-- genuine aggregation_depth bug would produce.\n--\n-- Returns rows on failure.\n\nwith detail as (\n    select\n        academic_year_start,\n        sum(start_count) as detail_starts\n    from `dfe-apprenticeships-2026`.`gold`.`fct_apprenticeship_headline`\n    where is_current\n      and geographic_level = 'National'\n      and is_detail_grain\n    group by academic_year_start\n),\npublished as (\n    select\n        academic_year_start,\n        start_count as published_starts\n    from `dfe-apprenticeships-2026`.`gold`.`fct_apprenticeship_headline`\n    where is_current\n      and geographic_level = 'National'\n      and aggregation_depth = 5\n      and start_count is not null\n)\nselect\n    p.academic_year_start,\n    d.detail_starts,\n    p.published_starts,\n    d.detail_starts - p.published_starts as difference,\n    safe_divide(abs(d.detail_starts - p.published_starts), p.published_starts) as rel_error\nfrom published p\njoin detail d using (academic_year_start)\nwhere safe_divide(abs(d.detail_starts - p.published_starts), p.published_starts) > 0.001", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-24T08:37:15.958705Z", "completed_at": "2026-08-24T08:37:15.972392Z"}, {"name": "execute", "started_at": "2026-08-24T08:37:15.973294Z", "completed_at": "2026-08-24T08:37:17.233648Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 1.2907772064208984, "adapter_response": {"_message": "SELECT (1.0 rows, 0 processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 0, "bytes_billed": 0, "location": "europe-west2", "project_id": "dfe-apprenticeships-2026", "job_id": "47490ffe-d911-48dd-8974-1209ad2402f5"}, "message": null, "failures": 0, "unique_id": "test.dfe_apprenticeships.not_null_fct_apprenticeship_headline_is_current.7520dc729f", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect is_current\nfrom `dfe-apprenticeships-2026`.`gold`.`fct_apprenticeship_headline`\nwhere is_current is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-24T08:37:15.947429Z", "completed_at": "2026-08-24T08:37:15.972715Z"}, {"name": "execute", "started_at": "2026-08-24T08:37:15.974636Z", "completed_at": "2026-08-24T08:37:17.368081Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 1.4254090785980225, "adapter_response": {"_message": "SELECT (1.0 rows, 0 processed)", "code": "SELECT", "rows_affected": 1, "bytes_processed": 0, "bytes_billed": 0, "location": "europe-west2", "project_id": "dfe-apprenticeships-2026", "job_id": "c6ed2816-bd6e-4a12-9491-1d054916e06f"}, "message": null, "failures": 0, "unique_id": "test.dfe_apprenticeships.dbt_utils_unique_combination_of_columns_stg_apprenticeships_row_key__dataset_version.3f31dfd779", "com